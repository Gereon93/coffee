# Rendered by the nginx entrypoint (envsubst) at container start.
# ${API_KEY} must match the API's `ApiKey` setting — the write endpoints
# (/coffee/power, POST+DELETE /api/stats/marked-days, /api/ingest) reject
# requests without it. Nginx injects it so the key never enters the browser
# bundle. Unset => empty header => the API answers 401.

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: all routes -> index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend container
    location /api/ {
        proxy_pass http://coffee-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key "${API_KEY}";
    }

    # Proxy coffee machine control endpoints
    location /coffee/ {
        proxy_pass http://coffee-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key "${API_KEY}";
    }

    # Proxy Scalar API docs and OpenAPI spec
    location /scalar/ {
        proxy_pass http://coffee-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /openapi/ {
        proxy_pass http://coffee-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
