{
  "ConnectionStrings": {
    "Default": "Data Source=coffee.db"
  },
  "N8n": {
    "PowerWebhookUrl": "https://n8n.example.com/webhook/coffee-power",
    "BasicAuthUser": "",
    "BasicAuthPassword": ""
  },
  "Watchdog": {
    "Enabled": true,
    "CheckIntervalMinutes": 5,
    "StaleAfterMinutes": 60,
    "QuietFromUtcHour": 1,
    "QuietToUtcHour": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
